# Messages F1= to F12= #
# Message CW_TU_MSG= #
# Message S&P_TU_MSG= #
# #
# % = call #
# @ = hiscall #
# # = serial #
# [ = RST #
# + = increase cw speed #
# - = decrease cw speed #
# (works only with parport #
# interface) #
# #
##################################
#
F1=+TEST -% %+TEST-
F2=%
#F3=+@ 5NN -# #
F4=TU 73
F5=@
F6=%
F7=@ SRI QSO B4 GL
F8=AGN
F9=?
F10=QRZ?
F11=PSE K
F12=+TEST -% %+ TEST-
